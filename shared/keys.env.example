# 密钥模板：复制成 .secrets/keys.env 再填（.secrets/ 已在 .gitignore，永不提交）
# 只填你要用的厂商。试听音色不需要任何 key；用某家音色正式配音时才需要那家的 key。
# 加载：set -a; . .secrets/keys.env; set +a

# 火山引擎 豆包语音（文件名 ark-…）  https://console.volcengine.com/speech
ARK_PLAN_API_KEY=
# MiniMax 语音（minimax-…）  https://platform.minimaxi.com
MINIMAX_API_KEY=
# 阿里云百炼 Qwen TTS（qwen-…）  https://bailian.console.aliyun.com
QWEN_TTS_API_KEY=
# 小米 MiMo TTS（mimo-…）  https://platform.xiaomimimo.com
MIMO_API_KEY=
